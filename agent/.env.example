# ==============================================================================
# Variáveis de Ambiente do Agente — Copie para .env e preencha os valores reais
# ==============================================================================

# Chave de autenticação do LLM (Google Gemini)
GOOGLE_API_KEY="Sua chave aqui"

# Modelo do LLM a ser utilizado (padrão: gemini-2.5-flash)
LLM_MODEL="gemini-2.5-flash"

# Rota base da API Node.js local
API_BASE_URL="http://localhost:3001/api"